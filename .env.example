# PostgreSQL connection (Supabase, Neon, RDS or local)
DATABASE_URL=postgres://tessera:tessera@localhost:5432/tessera

# Auth.js / NextAuth
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# File storage: "local" (dev only, writes to ./storage) or "s3" (any S3-compatible: AWS S3, Supabase Storage, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Max upload size in megabytes
MAX_UPLOAD_MB=25
NEXT_PUBLIC_MAX_UPLOAD_MB=25
CRON_SECRET=
